FROM rust:1.82-bookworm AS builder

WORKDIR /usr/src/phalanx
COPY . .

# Build with native microarchitecture optimizations
ENV RUSTFLAGS="-C target-cpu=native"

# Compile all verification and benchmark test binaries
RUN cargo build --release --tests --benches

FROM debian:bookworm-slim
WORKDIR /phalanx-cleanroom

# Copy pre-compiled test binaries from builder
COPY --from=builder /usr/src/phalanx/target/release/deps /phalanx-cleanroom/deps
COPY --from=builder /usr/src/phalanx/target/release/hotspot_mint* /phalanx-cleanroom/

ENV RUST_BACKTRACE=1

CMD ["sh", "-c", "echo '=== PHALANX ENGINE CLEANROOM VERIFICATION RUN ===' && ./hotspot_mint --bench"]
